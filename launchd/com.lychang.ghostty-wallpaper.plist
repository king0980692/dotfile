<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lychang.ghostty-wallpaper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/lychang/.config/leon_scripts/ghostty-wallpaper-update</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/com.lychang.ghostty-wallpaper.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.lychang.ghostty-wallpaper.err</string>
</dict>
</plist>
