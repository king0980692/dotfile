#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
key_file="$config_home/unsplash/access-key"
wallpaper_dir="$config_home/ghostty/wallpapers"
wallpaper="$config_home/ghostty/wallpaper.jpg"

if [[ ! -r "$key_file" ]]; then
    printf 'Missing Unsplash key file: %s\n' "$key_file" >&2
    exit 1
fi

export UNSPLASH_ACCESS_KEY
IFS= read -r UNSPLASH_ACCESS_KEY < "$key_file"
if [[ -z "$UNSPLASH_ACCESS_KEY" ]]; then
    printf 'Unsplash key file is empty: %s\n' "$key_file" >&2
    exit 1
fi

mkdir -p "$wallpaper_dir"
"$config_home/leon_scripts/unsplash-download" "Tokyo night" \
    --random --count 1 --size regular --orientation landscape \
    --output "$wallpaper_dir"

new_wallpaper="$(find "$wallpaper_dir" -maxdepth 1 -type f -name 'Tokyo-night-*' -print -quit)"
if [[ -z "$new_wallpaper" ]]; then
    printf 'No downloaded wallpaper found in %s\n' "$wallpaper_dir" >&2
    exit 1
fi

cp "$new_wallpaper" "$wallpaper.tmp.jpg"
mv "$wallpaper.tmp.jpg" "$wallpaper"
find "$wallpaper_dir" -maxdepth 1 -type f -name 'Tokyo-night-*' -delete

# Ghostty reloads its config on SIGUSR2. Ignore failure when Ghostty is closed.
pkill -USR2 -x ghostty 2>/dev/null || true
