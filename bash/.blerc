

#######################################
# Two-line dynamic prompt (root vs user)
########################################

# Disable ble.sh prompt override:
bleopt prompt_ps1_final=
bleopt prompt_ps1_transient=

# Pass M-hjkl to tmux for pane navigation
function ble/widget/tmux-select-pane-L { tmux select-pane -L; }
function ble/widget/tmux-select-pane-D { tmux select-pane -D; }
function ble/widget/tmux-select-pane-U { tmux select-pane -U; }
function ble/widget/tmux-select-pane-R { tmux select-pane -R; }
ble-bind -m vi_imap -f 'M-h' tmux-select-pane-L
ble-bind -m vi_imap -f 'M-j' tmux-select-pane-D
ble-bind -m vi_imap -f 'M-k' tmux-select-pane-U
ble-bind -m vi_imap -f 'M-l' tmux-select-pane-R
ble-bind -m vi_nmap -f 'M-h' tmux-select-pane-L
ble-bind -m vi_nmap -f 'M-j' tmux-select-pane-D
ble-bind -m vi_nmap -f 'M-k' tmux-select-pane-U
ble-bind -m vi_nmap -f 'M-l' tmux-select-pane-R
