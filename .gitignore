# Ignore everything by default
*

# Track these config directories
!.gitignore
!.gitconfig
!starship.toml
!install.sh
!uninstall.sh
!README.md

!bash/
!bash/**

# Coding agents: settings linked / merged into $HOME by agents/sync.sh
!agents/
!agents/**

!nvim/
!nvim/**

!mise/
!mise/**

!tmux/
!tmux/**
# Ignore tmux plugin repos (will be auto-installed)
tmux/plugins/

!leon_scripts/
!leon_scripts/**
# Local editor/script backups are not configuration.
leon_scripts/*.bak

!lazygit/
!lazygit/**

# Only the config: atuin keeps its key, session and history DB under
# ~/.local/share/atuin, so nothing secret lives in this directory.
!atuin/
!atuin/config.toml

!yazi/
!yazi/**

!kak/
!kak/**
# Symlink flipped at runtime to follow the terminal appearance; the two files
# it points at are generated by leon_scripts/yazi-theme-gen.sh and tracked.
yazi/theme.toml
# Third-party packages are restored from yazi/package.toml with `ya pkg install`.
yazi/flavors/
# Ignore third-party yazi plugin repos, but keep the ones written here.
yazi/plugins/*
!yazi/plugins/scp-back.yazi/

!git/
!git/**

!nix-darwin/
!nix-darwin/**

!karabiner/
!karabiner/**
karabiner/automatic_backups/

!skhd/
!skhd/**

!yabai/
!yabai/**

!ghostty/
!ghostty/**

!alacritty/
!alacritty/**
# Generated by leon_scripts/toggle_theme.sh from alacritty/themes/{dark,light}.toml
alacritty/theme.toml

# herdr: track config + scripts + our local plugin only. Everything else in
# herdr/ (logs, sockets, session*.json, plugins.json, release-notes, the
# auto-installed github/config plugins, sessions/, the resurrect/ output dir)
# stays ignored by the default `*` rule.
!herdr-sidebar/
!herdr-sidebar/settings.json

!herdr/
!herdr/config.toml
!herdr/scripts/
!herdr/scripts/**
!herdr/plugins/
!herdr/plugins/local/
!herdr/plugins/local/**
# ...but not python bytecode
herdr/scripts/**/__pycache__/

# systemd user units (herdr-resurrect save timer)
!systemd/
!systemd/**
# Host-specific TradingAgents jobs depend on a local checkout and schedule.
systemd/user/tw-market-*.service
systemd/user/tw-market-*.timer
systemd/user/timers.target.wants/tw-market-*.timer

# macOS user agents
!launchd/
!launchd/**

# Local secret and generated Ghostty wallpaper
unsplash/access-key
ghostty/wallpaper.jpg
ghostty/wallpapers/
